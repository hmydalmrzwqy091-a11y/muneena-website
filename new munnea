  <script>
    // language toggle
    const btn = document.getElementById('langBtn');
    const html = document.documentElement;
    const enEls = document.querySelectorAll('[data-en]');
    const arEls = document.querySelectorAll('[data-ar]');
    let isArabic = false;
    function setLang(ar){
      isArabic = ar;
      if(ar){
        html.lang='ar';
        html.setAttribute('lang','ar');
        enEls.forEach(e=>e.style.display='none');
        arEls.forEach(e=>e.style.display='inline');
        btn.textContent='EN / ع';
      } else {
        html.lang='en';
        enEls.forEach(e=>e.style.display='inline');
        arEls.forEach(e=>e.style.display='none');
        btn.textContent='ع / EN';
      }
    }
    btn.addEventListener('click',()=>setLang(!isArabic));
    setLang(false);

    // contact form: open WhatsApp with prefilled message
    document.getElementById('contactForm').addEventListener('submit',function(e){
      e.preventDefault();
      const name = encodeURIComponent(document.getElementById('name').value.trim());
      const msg = encodeURIComponent(document.getElementById('msg').value.trim());
      const phone = encodeURIComponent(document.getElementById('phone').value.trim());
      const fullMsg = `Name: ${name}%0APhone: ${phone}%0AMessage: ${msg}`;
      const wa = `https://api.whatsapp.com/send?phone=971562877616&text=${fullMsg}`;
      window.open(wa,'_blank');
    });

    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
