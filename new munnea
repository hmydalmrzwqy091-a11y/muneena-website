  <style>
    :root{
      --bg: rgb(250,237,182);
      --accent: #c9b68b;
      --text:#2b2b2b;
      --muted:#6b6b6b;
      --card:#fff;
      --radius:14px;
      --container:1100px;
      --transition:200ms ease;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;color:var(--text);background:var(--bg);}
    .wrap{max-width:var(--container);margin:0 auto;padding:28px}
    header{display:flex;align-items:center;justify-content:space-between;gap:20px}
    .brand{display:flex;align-items:center;gap:16px}
    .brand img{height:84px;width:auto;border-radius:10px;object-fit:cover}
    .brand h1{margin:0;font-size:28px;letter-spacing:2px}
    nav a{margin:0 10px;text-decoration:none;color:var(--text);font-weight:600}
    .lang-toggle{background:transparent;border:1px solid rgba(0,0,0,0.06);padding:8px 12px;border-radius:8px;cursor:pointer}

    /* Hero */
    .hero{display:flex;gap:30px;align-items:center;padding:40px 0}
    .hero-left{flex:1}
    .hero h2{font-size:36px;margin:0 0 8px}
    .hero p{margin:0 0 18px;color:var(--muted)}
    .cta{display:inline-block;padding:12px 18px;border-radius:10px;background:var(--text);color:white;text-decoration:none}

    /* Sections */
    section{padding:34px 0}
    .card{background:var(--card);border-radius:var(--radius);padding:18px;box-shadow:0 6px 20px rgba(0,0,0,0.06)}

    /* Products */
    .products{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}
    .product{padding:14px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.9),rgba(255,255,255,0.95));text-align:left}
    .product img{max-width:100%;height:200px;object-fit:cover;border-radius:10px}
    .price{font-weight:700;margin-top:8px}
    .product h4{margin:8px 0 6px}
    .desc{color:var(--muted);font-size:14px;margin-top:8px;line-height:1.4}

    /* Contact */
    .contact-grid{display:grid;grid-template-columns:1fr 320px;gap:18px}
    form label{display:block;margin-bottom:8px;font-weight:600}
    input,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #ddd;margin-bottom:12px}
    button[type=submit]{background:var(--text);color:white;padding:10px 14px;border-radius:10px;border:0;cursor:pointer}

    footer{padding:18px 0;color:var(--muted);text-align:center}

    /* small screens */
    @media(max-width:820px){
      .contact-grid{grid-template-columns:1fr}
      header{flex-direction:column;align-items:flex-start}
      .hero{flex-direction:column}
      .brand img{height:64px}
    }

    /* Arabic direction when active */
    html[lang="ar"]{direction:rtl}
    html[lang="ar"] .brand h1{font-family: 'Times New Roman', serif}
    .section-title{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .section-title h3{margin:0}
  </style>
</head>
